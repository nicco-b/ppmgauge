{
  // Test-only Worker config for @cloudflare/vitest-pool-workers. It intentionally
  // OMITS bindings the local test runtime can't emulate — AI and send_email — so
  // the worker hits its graceful fallbacks (if (!env.AI) → rules; !env.EMAIL +
  // DEV_EMAIL=1 → /auth/login returns the link inline). Also omits custom-domain
  // routes / crons / run_worker_first and pins an older compat date the bundled
  // workerd supports. D1/KV/R2 ARE emulated (real bindings via miniflare).
  "name": "water-lab-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": {
    "FROM_ADDRESS": "login@ppmgauge.com",
    "ADMIN_EMAIL": "test@ppmgauge.com",
    "DEV_EMAIL": "1"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "water-lab-test", "database_id": "test" }
  ],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "test-sessions" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "water-lab-test-photos" }]
}
