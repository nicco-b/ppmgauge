{
  "name": "water-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-31",
  // nodejs_compat: workers-og (satori+resvg) touches process.env for JEST detection.
  "compatibility_flags": ["nodejs_compat"],
  // Bundle the OG-card TTFs as ArrayBuffer imports (satori needs raw font data).
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "/" must run worker-first so the home page is server-rendered (appPage) rather
    // than served as a static index.html. "/index" legacy path 301s to /library.
    // Other app pages (/water, /logbook, /account) have no asset, so they fall through
    // to the worker naturally; the shell/body fragments + JS/CSS are served assets-first.
    "run_worker_first": ["/", "/index"]
  },
  "vars": {
    "FROM_ADDRESS": "login@ppmgauge.com",
    "ADMIN_EMAIL": "admin@example.com" // set your admin address (comma-separated list allowed)
  },
  "routes": [
    { "pattern": "ppmgauge.com", "custom_domain": true },
    { "pattern": "www.ppmgauge.com", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "water-lab", "database_id": "REPLACE_ME" }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "REPLACE_ME" }
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "water-lab-photos" }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "triggers": {
    "crons": [
      "0 14 * * *",
      "0 15 * * 1"
    ]
  }
}
